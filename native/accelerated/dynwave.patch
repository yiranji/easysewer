+static void initConduitNodeLists(void)
+{
+    int i, n1, n2;
+    size_t total, nodeCount, linkCount;
+    const size_t sizeMax = (size_t)-1;
+    size_t* cursor = NULL;
+    FREE(ConduitNodeOffsets);
+    FREE(ConduitNodeLinks);
+    ConduitNodeListsValid = FALSE;
+    if (Nobjects[NODE] <= 0 || Nobjects[LINK] < 0) return;
+    nodeCount = (size_t)Nobjects[NODE];
+    linkCount = (size_t)Nobjects[LINK];
+    // At most two adjacency entries per link. Bound every allocation and sum.
+    if (nodeCount > sizeMax / sizeof(size_t) - 1 ||
+        linkCount > sizeMax / (2 * sizeof(int))) return;
+    ConduitNodeOffsets = (size_t*)calloc(nodeCount + 1, sizeof(size_t));
+    if (ConduitNodeOffsets == NULL) goto failed;
+    for (i = 0; i < Nobjects[LINK]; i++)
+    {
+        if (!isTrueConduit(i)) continue;
+        n1 = Link[i].node1;
+        n2 = Link[i].node2;
+        if (n1 < 0 || n2 < 0 || (size_t)n1 >= nodeCount ||
+            (size_t)n2 >= nodeCount) goto failed;
+        ConduitNodeOffsets[n1 + 1]++;
+        if (n2 != n1) ConduitNodeOffsets[n2 + 1]++;
+    }
+    for (i = 0; i < Nobjects[NODE]; i++)
+        ConduitNodeOffsets[i + 1] += ConduitNodeOffsets[i];
+    total = ConduitNodeOffsets[Nobjects[NODE]];
+    if (total > 0)
+    {
+        ConduitNodeLinks = (int*)malloc(total * sizeof(int));
+        cursor = (size_t*)malloc(nodeCount * sizeof(size_t));
+        if (ConduitNodeLinks == NULL || cursor == NULL) goto failed;
+        for (i = 0; i < Nobjects[NODE]; i++) cursor[i] = ConduitNodeOffsets[i];
+        // Ascending Link order is the floating-point accumulation contract.
+        for (i = 0; i < Nobjects[LINK]; i++)
+        {
+            if (!isTrueConduit(i)) continue;
+            n1 = Link[i].node1;
+            n2 = Link[i].node2;
+            ConduitNodeLinks[cursor[n1]++] = i;
+            if (n2 != n1) ConduitNodeLinks[cursor[n2]++] = i;
+        }
+    }
+    FREE(cursor);
+    ConduitNodeListsValid = TRUE;
+    return;
+failed:
+    FREE(cursor);
+    FREE(ConduitNodeOffsets);
+    FREE(ConduitNodeLinks);
+    // Keep the original serial algorithm available when a cache cannot be built.
+}
