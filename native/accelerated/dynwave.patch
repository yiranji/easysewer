+static ES_ACCEL_ALWAYS_INLINE void gatherConduitNodeFlows(int node)
+{
+    size_t pos;
+    int i, k, n1, n2, barrels;
+    double q, conduitLossRate;
+    double nodeInflow, nodeOutflow, nodeSurfArea, nodeDqdh;
+
+    if (ConduitNodeOffsets[node] == ConduitNodeOffsets[node + 1]) return;
+    nodeInflow = Node[node].inflow;
+    nodeOutflow = Node[node].outflow;
+    nodeSurfArea = Xnode[node].newSurfArea;
+    nodeDqdh = Xnode[node].sumdqdh;
+
+    for (pos = ConduitNodeOffsets[node]; pos < ConduitNodeOffsets[node + 1]; pos++)
+    {
+        i = ConduitNodeLinks[pos];
+        n1 = Link[i].node1;
+        n2 = Link[i].node2;
+        q = Link[i].newFlow;
+        // Project the original statements onto this node without regrouping.
+        if (q >= 0.0)
+        {
+            if (node == n1) nodeOutflow += q;
+            if (node == n2) nodeInflow += q;
+        }
+        else
+        {
+            if (node == n1) nodeInflow -= q;
+            if (node == n2) nodeOutflow -= q;
+        }
+        k = Link[i].subIndex;
+        barrels = Conduit[k].barrels;
+        conduitLossRate = (Conduit[k].evapLossRate + Conduit[k].seepLossRate) * barrels;
+        if (conduitLossRate > 0.0)
+        {
+            if (Node[n1].type != OUTFALL && Node[n2].type != OUTFALL)
+                conduitLossRate /= 2.0;
+            if (node == n1 && Node[n1].type != OUTFALL)
+                nodeOutflow += conduitLossRate;
+            if (node == n2 && Node[n2].type != OUTFALL)
+                nodeOutflow += conduitLossRate;
+        }
+        if (node == n1) nodeSurfArea += Link[i].surfArea1 * barrels;
+        if (node == n2) nodeSurfArea += Link[i].surfArea2 * barrels;
+        if (node == n1) nodeDqdh += Link[i].dqdh;
+        if (node == n2) nodeDqdh += Link[i].dqdh;
+    }
+
+    Node[node].inflow = nodeInflow;
+    Node[node].outflow = nodeOutflow;
+    Xnode[node].newSurfArea = nodeSurfArea;
+    Xnode[node].sumdqdh = nodeDqdh;
+}
