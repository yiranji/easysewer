/* Appended to snow.c. Capture only at the successful engine step boundary. */
#include "es_checkpoint.h"

void es_ck_snow(EsCkCursor *c)
{
    int i, j, k;
    TSnowmelt *m;
    TSnowpack *p;
    if (c->error) return;
    es_ck_tag(c, "ESSNW001", 8);
    es_ck_fixed_i32(c, Nobjects[SNOWMELT]);
    es_ck_fixed_i32(c, Nobjects[SUBCATCH]);
    es_ck_fixed_i32(c, IgnoreSnowmelt);
    es_ck_fixed_i32(c, UnitSystem); es_ck_fixed_i32(c, FlowUnits);
    for (j = 0; j < Nobjects[SNOWMELT] && !c->error; j++)
    {
        m = &Snowmelt[j];
        es_ck_identity(c, m->ID);
        es_ck_fixed_f64(c, m->snn); es_ck_fixed_f64(c, m->weplow);
        es_ck_fixed_i32(c, m->toSubcatch);
        if (m->toSubcatch >= 0)
        {
            if (m->toSubcatch >= Nobjects[SUBCATCH])
            { es_ck_fail(c, ES_CK_STATE); return; }
            es_ck_identity(c, Subcatch[m->toSubcatch].ID);
        }
        for (i = 0; i < 5; i++) es_ck_fixed_f64(c, m->sfrac[i]);
        for (i = 0; i < 3; i++)
        {
            es_ck_fixed_f64(c, m->si[i]);
            es_ck_fixed_f64(c, m->dhmin[i]); es_ck_fixed_f64(c, m->dhmax[i]);
            es_ck_fixed_f64(c, m->tbase[i]); es_ck_fixed_f64(c, m->fwfrac[i]);
            es_ck_fixed_f64(c, m->wsnow[i]); es_ck_fixed_f64(c, m->fwnow[i]);
            /* Climate's restored LastDay can skip today's seasonal update. */
            es_ck_f64(c, &m->dhm[i]);
        }
    }
    for (j = 0; j < Nobjects[SUBCATCH] && !c->error; j++)
    {
        es_ck_identity(c, Subcatch[j].ID);
        p = Subcatch[j].snowpack;
        es_ck_fixed_i32(c, p != NULL);
        if (!p) continue;
        k = p->snowmeltIndex;
        if (k < 0 || k >= Nobjects[SNOWMELT])
        { es_ck_fail(c, ES_CK_STATE); return; }
        es_ck_fixed_i32(c, k);
        es_ck_fixed_f64(c, Subcatch[j].area);
        es_ck_fixed_f64(c, Subcatch[j].lidArea);
        for (i = 0; i < 3; i++)
        {
            es_ck_fixed_f64(c, p->fArea[i]);
            es_ck_f64(c, &p->wsnow[i]); es_ck_f64(c, &p->fw[i]);
            es_ck_f64(c, &p->coldc[i]); es_ck_f64(c, &p->ati[i]);
            es_ck_f64(c, &p->sba[i]); es_ck_f64(c, &p->awe[i]);
            es_ck_f64(c, &p->sbws[i]);
        }
        /* imelt is regenerated by snow_plowSnow for every consumed surface.
           Snow.removed/season and old/newSnowDepth have separate owners. */
    }
}
